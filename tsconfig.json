{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "@playwright/test"]
  },
  "include": ["pages/**/*.ts", "fixtures/**/*.ts", "tests/**/*.ts", "utils/**/*.ts", "playwright*.ts"]
}
